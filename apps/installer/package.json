{
  "name": "@orqestra/installer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "orqestra-install": "./dist/orqestra-install"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --minify --target=bun --outfile=dist/orqestra-install",
    "build:linux-x64": "bun build src/index.ts --compile --minify --target=bun-linux-x64 --outfile=dist/orqestra-install-linux-x64",
    "build:linux-arm64": "bun build src/index.ts --compile --minify --target=bun-linux-arm64 --outfile=dist/orqestra-install-linux-arm64",
    "build:darwin-arm64": "bun build src/index.ts --compile --minify --target=bun-darwin-arm64 --outfile=dist/orqestra-install-darwin-arm64",
    "build:darwin-x64": "bun build src/index.ts --compile --minify --target=bun-darwin-x64 --outfile=dist/orqestra-install-darwin-x64",
    "build:all": "pnpm build:linux-x64 && pnpm build:linux-arm64 && pnpm build:darwin-arm64 && pnpm build:darwin-x64",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@clack/prompts": "^0.8.2",
    "kleur": "^4.1.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.0"
  }
}
