# --- Postgres ---
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://orqestra:changeme@postgres:5432/orqestra

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth / Internal ---
BETTER_AUTH_SECRET=replace-with-32-plus-char-random-string-aaaaaa
BETTER_AUTH_URL=https://api.orqestra.xyz
INTERNAL_API_SECRET=replace-with-32-plus-char-random-string-bbbbbb

# --- Orchestrators (internal Docker network) ---
ORCHESTRATOR_JUPYTER_URL=http://orchestrator-jupyter:8080
ORCHESTRATOR_HOSTING_URL=http://orchestrator-hosting:8080

# --- Domain ---
SITE_DOMAIN=orqestra.xyz

# --- Traefik / Cloudflare DNS ---
CF_DNS_API_TOKEN=

# --- Local-mode overrides (laptop testing) ---
# Set when SITE_DOMAIN=localhost and you want containers reachable from a
# different machine on your LAN. LOCAL_BIND_IP=0.0.0.0 binds container ports
# on all interfaces; LOCAL_PUBLIC_HOST is the host/IP returned in URLs.
LOCAL_BIND_IP=
LOCAL_PUBLIC_HOST=

# --- Reserved RAM that scheduler keeps off the model budget (MB) ---
RESERVED_RAM_MB=2048

# --- Web (public) ---
NEXT_PUBLIC_API_URL=https://api.orqestra.xyz
NEXT_PUBLIC_WS_URL=wss://ws.orqestra.xyz

# --- Optional: AI diagnostics in installer ---
ANTHROPIC_API_KEY=
