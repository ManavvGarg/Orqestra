# different machine on your LAN. LOCAL_BIND_IP=0.0.0.0 binds container ports
# on all interfaces; LOCAL_PUBLIC_HOST is the host/IP returned in URLs.
LOCAL_BIND_IP=
LOCAL_PUBLIC_HOST=

# --- Reserved RAM that scheduler keeps off the model budget (MB) ---
RESERVED_RAM_MB=2048

# --- Web (public) ---
