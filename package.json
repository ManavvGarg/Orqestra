{
  "name": "orqestra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:push": "pnpm --filter @orqestra/db db:push",
    "db:migrate": "pnpm --filter @orqestra/db db:migrate",
    "db:studio": "pnpm --filter @orqestra/db db:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
